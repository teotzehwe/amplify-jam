{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "routes": [
    {
      "src": "^/api/(.*)$",
      "headers": { "cache-control": "no-store" },
      "dest": "/api/[...path]?path=$1"
    },
    { "src": "^/host$", "dest": "/host.html" },
    { "src": "^/board$", "dest": "/board.html" },
    { "handle": "filesystem" }
  ]
}
